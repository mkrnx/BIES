# ─────────────────────────────────────────────────────────────────────────────
# BIES Native (Capacitor) Build Environment Variables
#
# Copy this file to .env.native and fill in your production host, then build
# the web bundle for the native shell with:
#
#   npx vite build --mode native
#
# WHY THIS FILE IS REQUIRED:
# Inside the Capacitor iOS app the WebView origin is capacitor://localhost.
# The web app's defaults — a relative '/api' API base (src/services/api.js)
# and a relay URL derived from window.location (src/services/nostrService.js)
# — resolve against that origin and break every API call, the /ws realtime
# socket, /uploads media, and the private Nostr relay. Absolute production
# URLs MUST be baked in at build time for the native bundle.
#
# NEVER commit .env.native with real values to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Absolute API base URL of your production backend (must include /api)
VITE_API_URL=https://YOUR-PROD-HOST/api

# Absolute WebSocket URL of your private Nostr relay
VITE_NOSTR_RELAY=wss://YOUR-PROD-HOST/relay
